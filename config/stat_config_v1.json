  "horizon_buckets_days": [30, 90, 365, 1825],

  "dirichlet": {
    "id": "dir-v1-prudent",
    "alpha": {"base_rate": 8.0, "bayes_hierarchical": 0.25, "market_anchor": 0.25},
    "class_concentration": 20.0,
