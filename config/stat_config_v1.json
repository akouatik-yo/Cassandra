  "stacking": {
    "half_life_days": 180.0,
    "window_days": 730.0,
    "em_max_iter": 5000,
    "em_tol": 1e-13,
    "changepoint": {"method": "page_hinkley", "delta": 0.1, "threshold": 10.0, "min_obs": 8, "calibration": "seuil choisi le 2026-10-04 sur historiques synthétiques avant tout usage réel : 1 % de fausses alarmes (n=600 sains), 100 % de détection (60 résolutions dégradées sur 260)"}
