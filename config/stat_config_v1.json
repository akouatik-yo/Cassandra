  "ingestion": {"n_reformulations": 3, "n_extractions": 3, "temperature": 0.7, "seed": 1729},

  "evaluation": {"bootstrap_reps": 2000, "seed": 20261004, "calibration_bins": 10, "mcs_alpha": 0.10}
